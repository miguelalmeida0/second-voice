# Safe default: live owner-funded inference is disabled until every control below is configured.
AI_ENABLED=false

# Audited provider/model/pricing allowlist.
GHOSTWRITER_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GHOSTWRITER_AI_PRICING_VERSION=groq-openai-gpt-oss-20b-2026-09-07
GROQ_API_KEY=

# Server-only security and durable control store.
GHOSTWRITER_SECURITY_SECRET=
GHOSTWRITER_ABUSE_STORE_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deployment trust boundary.
NEXT_PUBLIC_SITE_URL=https://ghostwriter.example
GHOSTWRITER_TRUST_PROXY=true
GHOSTWRITER_CLIENT_IP_HEADER=x-forwarded-for
GHOSTWRITER_POW_DIFFICULTY=4
GHOSTWRITER_ALLOW_PUBLIC_SHARING=false

# Test runner only. Production validation rejects true.
GHOSTWRITER_E2E_FIXTURE_MODE=false

# Closed-beta account and generation limits.
GHOSTWRITER_BETA_MAX_APPROVED_ACCOUNTS=25
GHOSTWRITER_AI_LIFETIME_GENERATIONS_PER_ACCOUNT=10
GHOSTWRITER_AI_ACCOUNT_GENERATIONS_PER_24H=3
GHOSTWRITER_AI_ACCOUNT_GENERATIONS_PER_MINUTE=3
GHOSTWRITER_AI_ACCOUNT_CONCURRENCY=1
GHOSTWRITER_AI_GLOBAL_GENERATIONS_PER_MINUTE=6
GHOSTWRITER_AI_GLOBAL_CONCURRENCY=1

# Token, transport, and integer micro-USD ceilings.
GHOSTWRITER_AI_MAX_INPUT_TOKENS=2000
GHOSTWRITER_AI_MAX_OUTPUT_TOKENS=2000
GHOSTWRITER_AI_MAX_OPERATION_MICRO_USD=10000
GHOSTWRITER_AI_HOURLY_BUDGET_MICRO_USD=500000
GHOSTWRITER_AI_24H_BUDGET_MICRO_USD=2000000
GHOSTWRITER_AI_BETA_LIFETIME_BUDGET_MICRO_USD=10000000
GHOSTWRITER_AI_REQUEST_BODY_BYTES=10000
GHOSTWRITER_AI_REQUEST_TIMEOUT_MS=30000

# Separate long-lived fingerprint key. Never rotate by deleting operation history.
GHOSTWRITER_FINGERPRINT_SECRET=

# Portfolio Free-only profile. AI_ENABLED stays false until actual account plans,
# key ownership, target schema and authentication are verified by the owner.
# Metadata is not proof of a Free plan. Matching, expiring DB review also required.
GHOSTWRITER_RELEASE_PROFILE=portfolio-free
GROQ_FREE_ORGANIZATION_ID=
GROQ_FREE_PROJECT_ID=
GHOSTWRITER_GITHUB_LOGIN_ENABLED=false
GHOSTWRITER_EMAIL_LOGIN_ENABLED=false

# Vercel Cron authenticates the daily external database heartbeat. Server-only.
CRON_SECRET=
# Hard shared anonymous daily ceiling (<=60).
GHOSTWRITER_ANONYMOUS_GLOBAL_DAILY_LIMIT=60
