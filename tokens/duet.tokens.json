{
  "$description": "Second Voice Duet; DESIGN.md Preview first precedence. Canonical versioned authoring source, independent of marketing.",
  "$extensions": {
    "duet": {
      "version": 1,
      "owner": "second-voice/duet",
      "cssAliases": {
        "--duet-cream": "primitive.color.cream",
        "--duet-forest": "primitive.color.forest",
        "--duet-sage": "primitive.color.sage",
        "--duet-apricot": "primitive.color.apricot",
        "--duet-muted": "primitive.color.muted",
        "--duet-light-muted": "primitive.color.light-muted",
        "--duet-line": "primitive.color.line",
        "--duet-forest-line": "primitive.color.forest-line",
        "--duet-forest-control-line": "primitive.color.forest-control-line",
        "--duet-apricot-hover": "primitive.color.apricot-hover",
        "--duet-radius-panel": "semantic.geometry.radius-panel",
        "--duet-radius-pill": "semantic.geometry.radius-pill",
        "--duet-touch-target": "semantic.geometry.touch-target"
      },
      "runtimeBindings": {
        "desktopMin": "component.dock.breakpoint",
        "dockMinHeight": "component.dock.minimum-height",
        "dockEditorClearance": "component.dock.editor-clearance",
        "dockMaxRootFont": "component.dock.maximum-root-font",
        "dockClearance": "component.dock.clearance",
        "dockFocusClearance": "component.dock.focus-clearance",
        "keyboardRatio": "component.dock.keyboard-ratio",
        "dockMaxHeightRatio": "component.dock.maximum-height-ratio",
        "dialogMs": "semantic.motion.dialog",
        "resultMs": "semantic.motion.result",
        "reducedMs": "semantic.motion.reduced",
        "copyMs": "semantic.motion.copy",
        "easing": "semantic.motion.easing"
      },
      "contrastPairs": [
        {
          "name": "primary-on-canvas",
          "foreground": "semantic.text.primary",
          "background": "semantic.surface.canvas",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "secondary-on-canvas",
          "foreground": "semantic.text.secondary",
          "background": "semantic.surface.canvas",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "primary-on-sage",
          "foreground": "semantic.text.primary",
          "background": "semantic.surface.control",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "secondary-on-sage",
          "foreground": "semantic.text.secondary",
          "background": "semantic.surface.control",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "inverse-on-forest",
          "foreground": "semantic.text.inverse",
          "background": "semantic.surface.rewrite",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "muted-on-forest",
          "foreground": "semantic.text.inverse-secondary",
          "background": "semantic.surface.rewrite",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "inverse-on-inset",
          "foreground": "semantic.text.inverse",
          "background": "semantic.surface.inset",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "muted-on-inset",
          "foreground": "semantic.text.inverse-secondary",
          "background": "semantic.surface.inset",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "primary-action",
          "foreground": "semantic.text.primary",
          "background": "semantic.action.primary",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "primary-hover",
          "foreground": "semantic.text.primary",
          "background": "semantic.action.hover",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "composer",
          "foreground": "semantic.text.primary",
          "background": "semantic.surface.composer",
          "minimum": 4.5,
          "kind": "text"
        },
        {
          "name": "error-on-forest",
          "foreground": "semantic.state.error",
          "background": "semantic.surface.rewrite",
          "minimum": 4.5,
          "kind": "text"
        }
      ]
    }
  },
