{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-playwright-52415/types/**/*.ts",
    ".next-playwright-52415/dev/types/**/*.ts",
    ".next-playwright-3211/types/**/*.ts",
    ".next-playwright-3211/dev/types/**/*.ts",
    ".tmp/next-playwright-3211/types/**/*.ts",
    ".tmp/next-playwright-3211/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
