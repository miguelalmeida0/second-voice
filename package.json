{
  "name": "ghostwritter",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.23.2 <23" },
  "scripts": {
    "capture:film": "node scripts/capture-portfolio-film.mjs",
    "dev": "next dev -H 127.0.0.1 -p 4003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:check": "node scripts/security-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:ui": "playwright test --ui",
    "test:concurrency": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/ai-financial-boundary.test.ts",
    "test:integration": "node scripts/release/test-ledger.mjs",
    "test:release:gate": "npm run lint && npx tsc --noEmit && npm run test:security && npm run test:scroll && npm run test:integration && npm run test:e2e",
    "test:scroll": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/ui-layout-guard.test.ts",
    "test:security": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/*.test.ts",
    "test:unit": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/ghostwriter-portfolio-film.test.ts tests/ghostwriter-quality-contract.test.ts tests/observability.test.ts tests/provider-http.test.ts tests/rewrite-lab.test.ts",
    "verify:release": "node scripts/release/verify.mjs",
    "verify:portfolio": "node scripts/release/verify.mjs --portfolio",
    "test:portfolio": "node scripts/release/test-ledger.mjs --portfolio",
    "preflight:portfolio": "node scripts/release/preflight-portfolio.mjs",
    "preflight:deploy": "node scripts/release/preflight.mjs deploy",
    "preflight:enable-ai": "node scripts/release/preflight.mjs enable-ai"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "overrides": {
    "browserslist": "4.28.9",
    "js-yaml": "4.3.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
